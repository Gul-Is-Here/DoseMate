rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Account-wide state shared by all of the account's profiles.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validAccount(request.resource.data)
        && createdAtUnchanged(request.resource.data);
      allow delete: if false;

      // Managed profiles (Myself, Parent, Spouse, Other). Not separate
      // Firebase users: only the owning account can see or change them.
      match /profiles/{profileId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validProfile(uid, profileId, request.resource.data)
          // New profiles stamp the server time; migrated ones keep their
          // original creation time.
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt <= request.time;
        allow update: if isOwner(uid)
          && validProfile(uid, profileId, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;

        // Per-profile care records. Every path names the account and the
        // profile, so one profile's records can never be read or written
        // through another's.
        match /medicines/{medicineId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && profileExists(uid, profileId)
            && validMedicine(uid, profileId, medicineId, request.resource.data)
            && request.resource.data.createdAt == request.time;
          allow update: if isOwner(uid)
            && validMedicine(uid, profileId, medicineId, request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if isOwner(uid);
        }

        // Caregivers granted "Manage appointment schedule" may read, add
        // and reschedule visits, but not delete them.
        match /visits/{visitId} {
          allow read: if isOwner(uid)
            || isMember(uid, profileId, 'appointments');
          allow create: if (isOwner(uid)
              || isMember(uid, profileId, 'appointments'))
            && profileExists(uid, profileId)
            && validVisit(request.resource.data)
            && request.resource.data.createdAt == request.time;
          allow update: if (isOwner(uid)
              || isMember(uid, profileId, 'appointments'))
            && validVisit(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if isOwner(uid);
        }

        // A dose snoozed from its alarm (id: the dose log id), so the
        // server's "not logged yet" follow-up waits. Owner only; at most a
        // couple of hours ahead.
        match /doseSnoozes/{logId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['until'])
            && request.resource.data.until is timestamp
            && request.resource.data.until > request.time
            && request.resource.data.until < request.time + duration.value(2, 'h');
        }

        // One log per scheduled dose: the id is medicineId_day_minutes.
        // Each write carries the tap's revision: only a newer one, or a
        // retry of the same tap, is accepted. stockApplied is written only
        // by the applyDoseStock function.
        match /doseLogs/{logId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && validDoseLog(logId, request.resource.data)
            && request.resource.data.status in ['taken', 'skipped']
            && !('stockApplied' in request.resource.data)
            && !('legacyBase' in request.resource.data);
          allow update: if isOwner(uid)
            && validDoseLog(logId, request.resource.data)
            && (request.resource.data.rev > resource.data.get('rev', 0)
                || (request.resource.data.rev == resource.data.get('rev', 0)
                    && request.resource.data.actionId == resource.data.get('actionId', null)))
            && request.resource.data.get('stockApplied', null)
                == resource.data.get('stockApplied', null)
            // legacyBase: set once, by the first write over a Taken log from
            // before revisions (whose supply was already adjusted).
            && (request.resource.data.get('legacyBase', null)
                    == resource.data.get('legacyBase', null)
                || (!('rev' in resource.data)
                    && resource.data.status == 'taken'
                    && !('legacyBase' in resource.data)
                    && request.resource.data.legacyBase == 'taken'));
          allow delete: if isOwner(uid);
        }

        // Care circle. Members and their permissions are written only by
        // Cloud Functions (invite acceptance, owner changes), so nobody can
        // grant themselves access or widen it.
        match /members/{memberUid} {
          allow read: if isOwner(uid) || isSignedInAs(memberUid);
          allow write: if false;
        }

        // Caregiver-safe copies (no dosage, notes or photos), maintained by
        // Cloud Functions for "View daily dose checklist".
        match /shareChecklist/{medicineId} {
          allow read: if isOwner(uid) || isMember(uid, profileId, 'checklist');
          allow write: if false;
        }
        match /shareLogs/{logId} {
          allow read: if isOwner(uid) || isMember(uid, profileId, 'checklist');
          allow write: if false;
        }
      }

      // This account's devices, for its own alerts. The id is the device's
      // FCM token; only the signed-in owner can register or remove one.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'timezone', 'updatedAt'])
          && request.resource.data.token == token
          && token.size() > 0 && token.size() <= 4096
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() <= 64
          && request.resource.data.updatedAt == request.time;
      }

      // Profiles other accounts shared with this one (written on accept).
      match /sharedProfiles/{shareId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Invitations: created, sent and changed only by Cloud Functions; the
    // sender can watch their status. Token hashes never leave the server
    // through the client: the owner reads them, but they can't be reversed.
    match /invitations/{inviteId} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    function isSignedInAs(memberUid) {
      return request.auth != null && request.auth.uid == memberUid
        && request.auth.token.email_verified == true;
    }

    function isMember(uid, profileId, permission) {
      let path = /databases/$(database)/documents/users/$(uid)/profiles/$(profileId)/members/$(request.auth.uid);
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(path)
        && get(path).data.permissions[permission] == true;
    }

    function profileExists(uid, profileId) {
      return exists(/databases/$(database)/documents/users/$(uid)/profiles/$(profileId));
    }

    function isDay(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function validMedicine(uid, profileId, medicineId, data) {
      return data.keys().hasOnly([
          'name', 'dosage', 'notes', 'frequency', 'doseMinutes', 'days',
          'startDay', 'endDay', 'quantity', 'lowSupplyWarning', 'status',
          'photoUrl', 'photoPath', 'pastSchedules', 'pauses',
          'createdAt', 'updatedAt'])
        && (!('pastSchedules' in data)
            || (data.pastSchedules is list && data.pastSchedules.size() <= 30))
        && (!('pauses' in data) || (data.pauses is list && data.pauses.size() <= 30))
        && data.keys().hasAll([
          'name', 'frequency', 'doseMinutes', 'startDay', 'endDay',
          'quantity', 'status'])
        && medicineId.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && optionalString(data, 'dosage', 100)
        && optionalString(data, 'notes', 500)
        && data.frequency in ['onceDaily', 'multipleDaily', 'specificDays', 'asNeeded']
        && data.doseMinutes is list && data.doseMinutes.size() <= 24
        && (!('days' in data) || (data.days is list && data.days.size() <= 7))
        && isDay(data.startDay) && isDay(data.endDay)
        && data.endDay >= data.startDay
        // Quantity can dip just below zero if two devices log at once.
        && data.quantity is int && data.quantity >= -100 && data.quantity <= 100000
        && (!('lowSupplyWarning' in data) || data.lowSupplyWarning is bool)
        && data.status in ['active', 'paused', 'archived', 'draft']
        && optionalString(data, 'photoUrl', 2048)
        && (!('photoPath' in data)
            || (data.photoPath is string
                && data.photoPath.matches('users/' + uid + '/profiles/' + profileId
                    + '/medicines/' + medicineId + '/[^/]+')))
        && data.updatedAt == request.time;
    }

    function validVisit(data) {
      return data.keys().hasOnly([
          'title', 'category', 'startsAt', 'doctor', 'clinic', 'address',
          'phone', 'notes', 'reminders', 'departureAlerts', 'status',
          'placeId', 'placeName', 'latitude', 'longitude',
          'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'startsAt', 'status'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && optionalString(data, 'category', 40)
        && data.startsAt is timestamp
        && optionalString(data, 'doctor', 100)
        && optionalString(data, 'clinic', 100)
        && optionalString(data, 'address', 200)
        && optionalString(data, 'phone', 30)
        && optionalString(data, 'notes', 1000)
        && (!('reminders' in data) || (data.reminders is list && data.reminders.size() <= 4))
        && (!('departureAlerts' in data) || data.departureAlerts is bool)
        && data.status in ['scheduled', 'cancelled']
        && optionalString(data, 'placeId', 300)
        && optionalString(data, 'placeName', 200)
        // A chosen place always comes with both coordinates.
        && (('placeId' in data) == ('latitude' in data))
        && (('latitude' in data) == ('longitude' in data))
        && (!('latitude' in data)
            || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data)
            || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && data.updatedAt == request.time;
    }

    function validDoseLog(logId, data) {
      return data.keys().hasOnly(['medicineId', 'day', 'minutes', 'status', 'loggedAt', 'note',
          'medicineName', 'dosage', 'rev', 'actionId', 'actedAt', 'utcOffset', 'stockApplied',
          'legacyBase'])
        && data.rev is int && data.rev > 0
        // A device clock may run a little fast, not far enough to lock out others.
        && data.rev <= request.time.toMillis() + 300000
        && data.actionId is string && data.actionId.size() > 0 && data.actionId.size() <= 40
        && data.actedAt is timestamp
        && data.utcOffset is int && data.utcOffset >= -900 && data.utcOffset <= 900
        && optionalString(data, 'note', 200)
        // Snapshot of the medicine when logged, for history.
        && optionalString(data, 'medicineName', 100)
        && optionalString(data, 'dosage', 100)
        && data.medicineId is string && data.medicineId.size() > 0
        && data.medicineId.size() <= 64
        && isDay(data.day)
        && data.minutes is int && data.minutes >= 0 && data.minutes < 1440
        && logId == data.medicineId + '_' + data.day + '_' + string(data.minutes)
        && data.status in ['taken', 'skipped', 'cleared']
        && data.loggedAt == request.time;
    }

    // Signed in as this account with a verified email. Google accounts are
    // verified by Google; email/password accounts must open the link first.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function createdAtUnchanged(data) {
      return resource == null
        ? (!('createdAt' in data) || data.createdAt == request.time)
        : data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // Pre-profiles personal fields may be kept as they were or removed (by
    // the migration), but never written or changed.
    function legacyKept(data, field) {
      return !(field in data)
        || (resource != null && field in resource.data && data[field] == resource.data[field]);
    }

    function validAccount(data) {
      return data.keys().hasOnly([
          'setupCompleted', 'activeProfileId', 'profilesMigratedAt',
          'createdAt', 'updatedAt',
          'profileFor', 'fullName', 'relationship', 'dateOfBirth',
          'emergencyContactName', 'emergencyContactPhone',
          'photoUrl', 'photoPath', 'profileCompleted'])
        && data.updatedAt == request.time
        && (!('setupCompleted' in data) || data.setupCompleted is bool)
        && optionalString(data, 'activeProfileId', 64)
        && (!('profilesMigratedAt' in data) || data.profilesMigratedAt is timestamp)
        && legacyKept(data, 'profileFor') && legacyKept(data, 'fullName')
        && legacyKept(data, 'relationship') && legacyKept(data, 'dateOfBirth')
        && legacyKept(data, 'emergencyContactName') && legacyKept(data, 'emergencyContactPhone')
        && legacyKept(data, 'photoUrl') && legacyKept(data, 'photoPath')
        && legacyKept(data, 'profileCompleted');
    }

    function validProfile(uid, profileId, data) {
      return data.keys().hasOnly([
          'type', 'fullName', 'relationship', 'dateOfBirth',
          'emergencyContactName', 'emergencyContactPhone',
          'photoUrl', 'photoPath', 'createdAt', 'updatedAt'])
        && data.type in ['self', 'parent', 'spouse', 'other']
        // "self" is always and only the account holder.
        && ((profileId == 'self') == (data.type == 'self'))
        && profileId.size() <= 64
        && data.fullName is string
        && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.updatedAt == request.time
        && optionalString(data, 'relationship', 60)
        && optionalString(data, 'emergencyContactName', 100)
        && optionalString(data, 'emergencyContactPhone', 30)
        && optionalString(data, 'photoUrl', 2048)
        && (!('photoPath' in data)
            || (data.photoPath is string
                && (data.photoPath.matches('users/' + uid + '/profiles/' + profileId + '/[^/]+')
                    // Photos migrated from before profiles existed.
                    || data.photoPath.matches('users/' + uid + '/profile/[^/]+'))))
        && (!('dateOfBirth' in data)
            || (data.dateOfBirth is timestamp && data.dateOfBirth < request.time));
    }
  }
}
